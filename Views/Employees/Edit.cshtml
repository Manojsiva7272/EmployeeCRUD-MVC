@model Employee
@{ ViewData["Title"] = "Edit Employee"; }
<div class="card p-4">
    <h2>Edit Employee</h2><p class="text-muted">Update the employee details.</p>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <partial name="_EmployeeForm" model="Model" />
        <div class="mt-4"><button type="submit" class="btn btn-primary">Update Employee</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div>
    </form>
</div>