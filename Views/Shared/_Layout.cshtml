<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Employee CRUD</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background:#f5f7fb; }
        .navbar { background:#14213d; }
        .navbar-brand { color:#fff!important; font-weight:700; }
        .card { border:0; border-radius:14px; box-shadow:0 6px 22px rgba(20,33,61,.08); }
        .table thead th { background:#eef2f8; }
        .btn-primary { background:#2457c5; border-color:#2457c5; }
    </style>
</head>
<body>
<nav class="navbar navbar-expand-lg mb-4">
    <div class="container"><a class="navbar-brand" asp-controller="Employees" asp-action="Index">Employee CRUD</a>
        <a class="btn btn-light btn-sm" asp-controller="Employees" asp-action="Create">+ Add Employee</a>
    </div>
</nav>
<main class="container pb-5">
    @if (TempData["Success"] != null) {
        <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @RenderBody()
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>